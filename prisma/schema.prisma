generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The app connects through the pooler (many short-lived serverless connections).
  url       = env("DATABASE_URL")
  // Migrations need a direct connection: poolers don't keep the session state
  // `prisma migrate` relies on. Locally both point at the same database.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Auth.js models (don't rename models/fields: the PrismaAdapter uses them) ──

model User {
  id                   String           @id @default(cuid())
  name                 String?
  email                String           @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String? // email + password login (Credentials provider)
  // The nutritionist's own fields
  licenseNumber        String? // professional license ("cédula"), shown on the PDF
  logoUrl              String?
  promptStyle          String? // style preferences for AI-generated plans
  createdAt            DateTime         @default(now())
  // Account administration (/admin panel)
  role                 Role             @default(NUTRITIONIST)
  status               AccountStatus    @default(ACTIVE)
  tier                 PlanTier         @default(FREE)
  tierUpdatedAt        DateTime?
  suspendedAt          DateTime?
  adminNotes           String?
  // Subscription: filled from Stripe webhooks once billing is integrated
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?
  accounts             Account[]
  sessions             Session[]
  patients             Patient[]
  consultations        Consultation[]
  featureRequests      FeatureRequest[]
  appointments         Appointment[]
}

enum Role {
  ADMIN
  NUTRITIONIST
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING // reserved for manually approving sign-ups during beta
}

enum PlanTier {
  FREE
  PRO
  UNLIMITED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Domain ───────────────────────────────────────────────────────────────

model Patient {
  id            String         @id @default(cuid())
  // Multi-tenant isolation: every patient belongs to a nutritionist
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  birthDate     DateTime
  gender        Gender
  email         String?
  phone         String?
  notes         String?
  consentAt     DateTime? // consent to process health data
  createdAt     DateTime       @default(now())
  consultations Consultation[]
  appointments  Appointment[]

  @@index([userId])
}

enum Gender {
  FEMALE
  MALE
  OTHER
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Multi-tenant isolation: every appointment belongs to a nutritionist
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // UTC instant. Captured and displayed in America/Mexico_City (lib/dates.ts):
  // the production server runs in UTC and its local zone can't be trusted.
  startsAt    DateTime
  durationMin Int               @default(60)
  status      AppointmentStatus @default(SCHEDULED)
  notes       String? // logistics, not clinical: reason, whether someone comes along, etc.
  createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([patientId])
  @@index([userId, startsAt]) // the monthly grid filters by date range
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Consultation {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Anthropometrics
  weight     Float // kg
  height     Float // cm
  waist      Float?
  hip        Float?
  arm        Float?
  bodyFatPct Float? // %

  goals        String
  restrictions String // allergies, medical conditions, preferences

  // Audio (Phase 2)
  audioUrl   String?
  transcript String?

  // AI
  generatedPlan   Json? // raw model output (audit)
  finalPlan       Json? // version edited by the nutritionist
  promptVersion   String? // which prompt version generated the plan
  aiModel         String? // model that generated the plan (audit)
  inputTokens     Int?
  outputTokens    Int?
  generationCount Int     @default(0) // AI calls for this consultation; capped in lib/limits.ts

  approvedAt DateTime? // the PDF is only exported when this is not null
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([patientId])
}

model FeatureRequest {
  id              String               @id @default(cuid())
  // Multi-tenant: each request belongs to the nutritionist who sent it
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String
  status          FeatureRequestStatus @default(NEW)
  adminResponse   String? // shown to the nutritionist next to the status
  respondedAt     DateTime?
  // AI feasibility analysis (scripts/analyze-feature-requests.mjs)
  aiAnalysis      String?
  aiVerdict       String? // "VIABLE" | "NOT_VIABLE" | "NEEDS_DESIGN"
  aiDraftResponse String? // draft reply to the nutritionist; only published if the admin saves it
  analyzedAt      DateTime?
  createdAt       DateTime             @default(now())

  @@index([userId])
  @@index([status])
}

enum FeatureRequestStatus {
  NEW
  IN_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}
